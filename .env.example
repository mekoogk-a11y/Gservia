# GServia Universal Platform Configuration
PORT=3000
NODE_ENV=development

# Authentication & Session Security
JWT_SECRET=your_super_secret_jwt_signing_key_here
SESSION_COOKIE_SECRET=your_cookie_secret_key

# Official Google Cloud & OAuth 2.0 Integration (Client-Side / Server-Side OAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-domain.com/api/auth/callback/google

# Optional Gemini & AI Engine Integration
GEMINI_API_KEY=

# Optional Multi-Provider Integrations
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
OPENAI_API_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
